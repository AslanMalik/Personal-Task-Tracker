          "response": [
            {
              "name": "200 OK",
              "status": "OK",
              "code": 200,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"username\": \"newusername\",\n  \"email\": \"newemail@example.com\"\n}"
            },
            {
              "name": "400 Username taken",
              "status": "Bad Request",
              "code": 400,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"error\": \"Username already taken\"\n}"
