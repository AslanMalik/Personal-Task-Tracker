{
  "info": {
    "name": "TaskTracker API",
    "_postman_id": "tasktracker-api-collection",
    "description": "Full API collection for TaskTracker (Django + DRF). Base URL: http://127.0.0.1:8000/api\n\nAuth: After login, copy the `access` token and set it as the `token` variable in the collection.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000/api",
      "type": "string"
    },
    {
      "key": "token",
      "value": "your_access_token_here",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/register/", "host": ["{{base_url}}"], "path": ["register", ""] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"testuser\",\n  \"password\": \"testpass123\",\n  \"email\": \"test@example.com\"\n}"
            },
            "description": "Register a new user. Returns JWT access and refresh tokens."
          },
          "response": [
            {
              "name": "201 Created",
              "status": "Created",
              "code": 201,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"refresh\": \"eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...\",\n  \"access\": \"eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...\"\n}"
            },
            {
              "name": "400 Username taken",
              "status": "Bad Request",
              "code": 400,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"error\": \"Username already taken\"\n}"
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/login/", "host": ["{{base_url}}"], "path": ["login", ""] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"testuser\",\n  \"password\": \"testpass123\"\n}"
            },
            "description": "Login with credentials. Copy the `access` value into the `token` collection variable."
          },
          "response": [
            {
              "name": "200 OK",
              "status": "OK",
              "code": 200,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"refresh\": \"eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...\",\n  \"access\": \"eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...\"\n}"
            },
            {
              "name": "400 Invalid credentials",
              "status": "Bad Request",
              "code": 400,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"error\": \"Invalid credentials\"\n}"
            }
          ]
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": { "raw": "{{base_url}}/logout/", "host": ["{{base_url}}"], "path": ["logout", ""] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh\": \"eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...\"\n}"
            },
            "description": "Blacklists the refresh token. Requires the refresh token in the body."
          },
          "response": [
            {
              "name": "200 OK",
              "status": "OK",
              "code": 200,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"message\": \"Logged out\"\n}"
            },
            {
              "name": "400 Invalid token",
              "status": "Bad Request",
              "code": 400,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"error\": \"Invalid token\"\n}"
            }
          ]
        }
      ]
    },
    {
      "name": "Tasks",
      "item": [
        {
          "name": "Get All Tasks",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{base_url}}/tasks/", "host": ["{{base_url}}"], "path": ["tasks", ""] },
            "description": "Returns all tasks belonging to the authenticated user."
          },
          "response": [
            {
              "name": "200 OK",
              "status": "OK",
              "code": 200,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "[\n  {\n    \"id\": 1,\n    \"title\": \"Buy groceries\",\n    \"description\": \"Milk, eggs, bread\",\n    \"status\": \"todo\",\n    \"category\": 2,\n    \"deadline\": \"2025-05-01T10:00:00Z\",\n    \"created_at\": \"2025-04-20T08:00:00Z\",\n    \"subtasks\": []\n  }\n]"
            }
          ]
        },
        {
          "name": "Create Task",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": { "raw": "{{base_url}}/tasks/", "host": ["{{base_url}}"], "path": ["tasks", ""] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Buy groceries\",\n  \"description\": \"Milk, eggs, bread\",\n  \"status\": \"todo\",\n  \"category\": 1,\n  \"deadline\": \"2025-05-01T10:00:00Z\"\n}"
            },
            "description": "Creates a new task linked to the authenticated user."
          },
          "response": [
            {
              "name": "201 Created",
              "status": "Created",
              "code": 201,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"id\": 1,\n  \"title\": \"Buy groceries\",\n  \"description\": \"Milk, eggs, bread\",\n  \"status\": \"todo\",\n  \"category\": 1,\n  \"deadline\": \"2025-05-01T10:00:00Z\",\n  \"created_at\": \"2025-04-20T08:00:00Z\",\n  \"subtasks\": []\n}"
            }
          ]
        },
        {
          "name": "Get Task by ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{base_url}}/tasks/1/", "host": ["{{base_url}}"], "path": ["tasks", "1", ""] },
            "description": "Returns a single task by ID."
          },
          "response": [
            {
              "name": "200 OK",
              "status": "OK",
              "code": 200,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"id\": 1,\n  \"title\": \"Buy groceries\",\n  \"description\": \"Milk, eggs, bread\",\n  \"status\": \"todo\",\n  \"category\": 1,\n  \"deadline\": \"2025-05-01T10:00:00Z\",\n  \"created_at\": \"2025-04-20T08:00:00Z\",\n  \"subtasks\": []\n}"
            },
            {
              "name": "404 Not Found",
              "status": "Not Found",
              "code": 404,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"error\": \"Not found\"\n}"
            }
          ]
        },
        {
          "name": "Update Task (PUT)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": { "raw": "{{base_url}}/tasks/1/", "host": ["{{base_url}}"], "path": ["tasks", "1", ""] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Buy groceries\",\n  \"description\": \"Updated list\",\n  \"status\": \"in_progress\",\n  \"category\": 1,\n  \"deadline\": \"2025-05-01T10:00:00Z\"\n}"
            },
            "description": "Full update of a task (all fields required)."
          },
          "response": [
            {
              "name": "200 OK",
              "status": "OK",
              "code": 200,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"id\": 1,\n  \"title\": \"Buy groceries\",\n  \"description\": \"Updated list\",\n  \"status\": \"in_progress\",\n  \"category\": 1,\n  \"deadline\": \"2025-05-01T10:00:00Z\",\n  \"created_at\": \"2025-04-20T08:00:00Z\",\n  \"subtasks\": []\n}"
            }
          ]
        },
        {
          "name": "Partial Update Task (PATCH)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": { "raw": "{{base_url}}/tasks/1/", "host": ["{{base_url}}"], "path": ["tasks", "1", ""] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"done\"\n}"
            },
            "description": "Partial update — only send fields you want to change."
          },
          "response": [
            {
              "name": "200 OK",
              "status": "OK",
              "code": 200,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"id\": 1,\n  \"title\": \"Buy groceries\",\n  \"description\": \"Updated list\",\n  \"status\": \"done\",\n  \"category\": 1,\n  \"deadline\": \"2025-05-01T10:00:00Z\",\n  \"created_at\": \"2025-04-20T08:00:00Z\",\n  \"subtasks\": []\n}"
            }
          ]
        },
        {
          "name": "Delete Task",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{base_url}}/tasks/1/", "host": ["{{base_url}}"], "path": ["tasks", "1", ""] },
            "description": "Permanently deletes a task."
          },
          "response": [
            {
              "name": "204 No Content",
              "status": "No Content",
              "code": 204,
              "header": [],
              "body": ""
            }
          ]
        }
      ]
    },
    {
      "name": "Subtasks",
      "item": [
        {
          "name": "Create Subtask",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": { "raw": "{{base_url}}/tasks/1/subtasks/", "host": ["{{base_url}}"], "path": ["tasks", "1", "subtasks", ""] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Buy milk\",\n  \"is_completed\": false\n}"
            },
            "description": "Creates a subtask under a specific task."
          },
          "response": [
            {
              "name": "201 Created",
              "status": "Created",
              "code": 201,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"id\": 1,\n  \"title\": \"Buy milk\",\n  \"is_completed\": false,\n  \"task\": 1,\n  \"created_at\": \"2025-04-20T09:00:00Z\"\n}"
            }
          ]
        },
        {
          "name": "Toggle Subtask (PATCH)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": { "raw": "{{base_url}}/subtasks/1/", "host": ["{{base_url}}"], "path": ["subtasks", "1", ""] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"is_completed\": true\n}"
            },
            "description": "Toggle subtask completion. If all subtasks are done, parent task becomes 'done' automatically."
          },
          "response": [
            {
              "name": "200 OK",
              "status": "OK",
              "code": 200,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"id\": 1,\n  \"title\": \"Buy milk\",\n  \"is_completed\": true,\n  \"task\": 1,\n  \"created_at\": \"2025-04-20T09:00:00Z\"\n}"
            }
          ]
        },
        {
          "name": "Delete Subtask",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{base_url}}/subtasks/1/", "host": ["{{base_url}}"], "path": ["subtasks", "1", ""] },
            "description": "Deletes a subtask by ID."
          },
          "response": [
            {
              "name": "204 No Content",
              "status": "No Content",
              "code": 204,
              "header": [],
              "body": ""
            }
          ]
        }
      ]
    },
