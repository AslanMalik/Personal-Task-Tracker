        {
          "name": "Change Password",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": { "raw": "{{base_url}}/change-password/", "host": ["{{base_url}}"], "path": ["change-password", ""] },
            "body": {
              "mode": "raw",
